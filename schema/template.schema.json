  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^[ -~]*$",
          "description": "LCD label, printable ASCII"
        },
        "type": {
          "anyOf": [
            {
              "enum": [
                "bank_change",
                "cc",
                "drum_note",
                "mmc",
                "none",
                "note",
                "nrpn",
                "pitch_bend",
                "program_change",
                "realtime",
                "rpn",
                "sysex",
                "template"
              ]
            },
            {
              "type": "string",
              "pattern": "^type_[0-9]{1,3}$"
            }
          ],
          "description": "Control type; type_N keeps codes not yet named"
        },
        "low": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383,
          "description": "LowVal (also MMC command, note number, template number)"
        },
        "high": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383,
          "description": "HighVal (also MMC device id)"
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "CC number, or NRPN/RPN LSB"
        },
        "number_msb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "NRPN/RPN MSB"
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "Raw channel code (encoding unconfirmed, docs/FORMAT.md +19)"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "Raw port routing code (encoding unconfirmed, docs/FORMAT.md +18)"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383,
          "description": "Stored control value"
        },
        "button_mode": {
          "enum": [
            "normal",
            "momentary",
            "toggle",
            "step",
            "bits_12",
            "bits_20",
            "bits_24",
            "bits_28"
          ]
        },
        "display": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "Display type code: 0 = 0-127, 1 = -64/+63, others unconfirmed"
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127,
          "description": "Step size for STEP buttons"
        },
        "sysex": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "data_type": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127,
              "description": "0 NONE, 1 SINGLE, others unconfirmed"
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "data_position": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "data": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              }
            }
          }
        },
        "_raw": {
          "type": "string",
          "pattern": "^([0-9a-f]{2} ){40}[0-9a-f]{2}$",
          "description": "Original 41-byte record; bytes not covered by fields come from here"
        }
      }
    }
  }
